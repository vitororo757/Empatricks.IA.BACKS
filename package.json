{
  "name": "emprest-ai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm prisma:generate && nest build",
    "start": "node --env-file-if-exists=.env.local .nest-build/main.js",
    "start:dev": "node --env-file-if-exists=.env.local ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "test": "pnpm build && node --env-file-if-exists=.env.local --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:db": "pnpm build && node --env-file-if-exists=.env.local --experimental-vm-modules ./test/run-db-tests.mjs",
    "prisma:generate": "prisma generate --config prisma7.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@nestjs/cli": "^12.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "prisma": "7.10.1",
    "supabase": "2.121.0",
    "typescript": "^6.0.0"
  }
}
